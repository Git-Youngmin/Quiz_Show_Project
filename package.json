{
  "name": "quiz-show-project",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend && npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "start": "node backend/dist/server.js",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend",
    "test:ws": "npm run test:ws -w backend",
    "test:game": "npm run test:game -w backend",
    "test:auth": "npm run test:auth -w backend"
  },
  "engines": {
    "node": ">=20"
  }
}
